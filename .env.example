# Local-first defaults. Copy this file to .env to customize.
APP_TITLE=Personal Knowledge Agent
HOST=127.0.0.1
PORT=8000
APP_PASSWORD=
MAX_UPLOAD_MB=15
VAULT_SYNC_SECONDS=45
DATA_DIR=./data
VAULT_DIR=./vault

# Optional OpenAI-compatible Chat Completions endpoint.
# Without these values, local storage/search still works; answers/summaries/drafts use fallback behavior.
# Model providers receive the content included in each request; review your provider's privacy policy.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Optional generic IMAP/SMTP integration. Use an app password/OAuth where supported.
# First configure IMAP for read/sync. SMTP is only used after you click the explicit send button.
MAIL_ACCOUNT=default
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=120
IMAP_INITIAL_BACKFILL=80
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=
